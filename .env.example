# Credenciales SMTP que usa la API para enviar correos (mínimo 12 caracteres, sin «:»).
MAIL_USERNAME=smartpot
MAIL_PASSWORD=<MAIL_PASSWORD>

# Acceso a la interfaz web y a la API de Mailpit (mínimo 12 caracteres, sin «:»).
MAILPIT_UI_USERNAME=admin
MAILPIT_UI_PASSWORD=<MAILPIT_UI_PASSWORD>

# Retención de mensajes capturados.
MP_MAX_MESSAGES=500
MP_MAX_AGE=30d

# Opcional: reenviar todo a un SMTP real (Gmail, SES, etc.).
# MP_SMTP_RELAY_HOST=smtp.gmail.com
# MP_SMTP_RELAY_PORT=587
# MP_SMTP_RELAY_STARTTLS=true
# MP_SMTP_RELAY_AUTH=plain
# MP_SMTP_RELAY_USERNAME=<RELAY_USERNAME>
# MP_SMTP_RELAY_PASSWORD=<RELAY_PASSWORD>
# MP_SMTP_RELAY_ALL=true
